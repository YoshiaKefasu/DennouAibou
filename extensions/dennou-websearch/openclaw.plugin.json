{
  "id": "dennou-websearch",
  "enabledByDefault": true,
  "name": "Dennou WebSearch",
  "description": "Web search and fetch tools for DennouAibou",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "summarizer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "model": { "type": "string" },
          "endpoint": { "type": "string" },
          "apiKey": { "type": ["string", "object"] },
          "referenceLimit": { "type": "integer", "minimum": 1 },
          "timeoutMs": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
