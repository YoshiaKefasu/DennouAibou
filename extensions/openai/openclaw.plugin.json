{
  "id": "openai",
  "enabledByDefault": true,
  "providers": ["openai"],
  "modelSupport": {
    "modelPrefixes": ["gpt-", "o1", "o3", "o4"]
  },
  "providerAuthEnvVars": {
    "openai": ["OPENAI_API_KEY"]
  },
  "providerAuthChoices": [
    {
      "provider": "openai",
      "method": "api-key",
      "choiceId": "openai-api-key",
      "choiceLabel": "OpenAI API key",
      "groupId": "openai",
      "groupLabel": "OpenAI",
      "groupHint": "API key",
      "optionKey": "openaiApiKey",
      "cliFlag": "--openai-api-key",
      "cliOption": "--openai-api-key <key>",
      "cliDescription": "OpenAI API key"
    }
  ],
  "contracts": {
    "speechProviders": ["openai"],
    "mediaUnderstandingProviders": ["openai"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "personality": {
        "type": "string",
        "enum": ["friendly", "off"],
        "default": "friendly",
        "description": "Controls the default OpenAI-specific personality used for OpenAI runs."
      }
    }
  }
}
