{
  "id": "raw-chat-search",
  "name": "電脳神経 (Raw Chat Search)",
  "description": "Permanent raw chat SQLite index and FTS5 search",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "language": {
        "type": "string",
        "default": "ja",
        "description": "Output language for Dream-merged memo prose (2-letter ISO 639-1 code, e.g. ja, en). IDs, JSON keys, and technical terms stay in English."
      },
      "memo": {
        "type": "object",
        "properties": {
          "maxTokens": {
            "type": "number",
            "default": 4000,
            "description": "System prompt memo token limit"
          }
        }
      },
      "dream": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "schedule": {
            "type": "string",
            "default": "0 3 * * *"
          },
          "model": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "default": "ja",
            "description": "Output language for Dream-merged memo prose (2-letter ISO 639-1 code). Wins over the plugin-level language."
          }
        }
      }
    }
  }
}
