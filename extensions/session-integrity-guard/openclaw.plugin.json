{
  "id": "session-integrity-guard",
  "kind": "memory",
  "uiHints": {
    "frequency": {
      "label": "Health Check Frequency",
      "placeholder": "0 3 * * *",
      "help": "Cron cadence for the session integrity health check (default: 0 3 * * *)."
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "frequency": {
        "type": "string"
      },
      "timezone": {
        "type": "string"
      },
      "autoRepair": {
        "type": "boolean",
        "description": "When true, orphan rows with type !== \"message\" are removed automatically after a backup is taken."
      },
      "notify": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Toggle the Discord / Telegram announce cron job."
          },
          "channel": {
            "type": "string",
            "enum": ["discord", "telegram"]
          },
          "accountId": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "bestEffort": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
