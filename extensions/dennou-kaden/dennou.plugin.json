{
  "id": "dennou-kaden",
  "name": "電脳架電 (Dennou Kaden)",
  "description": "Go native low-latency voice call daemon and tools",
  "kind": "binary",
  "executable": "./bin/kaden",
  "tools": [
    {
      "name": "kaden_status",
      "description": "Get current status of dennou-kaden voice daemon",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "kaden_call",
      "description": "Report daemon status or ping it",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["status", "ping"],
            "description": "Call action: status, ping"
          }
        },
        "required": ["action"]
      }
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean" },
      "port": { "type": "integer" }
    }
  }
}
